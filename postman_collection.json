    {
      "name": "5 Resilience (manual)",
      "item": [
        {
          "name": "Create ticket while route-service is down",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"route_id\": \"{{routeId}}\",\n  \"passenger_name\": \"Test User\",\n  \"travel_date\": \"{{travelDate}}\",\n  \"seats\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Expect 503. First three calls show retries; once the breaker opens the message becomes 'circuit breaker open'."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 503\", function () { pm.response.to.have.status(503); });",
                  "pm.test(\"Response has a JSON error message\", function () { pm.expect(pm.response.json()).to.have.property(\"error\"); });",
                  "pm.test(\"gRPC code is Unavailable\", function () { pm.expect(pm.response.json().grpc_code).to.eql(\"Unavailable\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get ticket (fallback while route-service is down)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets/{{fallbackTicketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets",
                "{{fallbackTicketId}}"
              ]
            },
            "description": "Set the collection variable fallbackTicketId to any existing ticket id first (copy one from 'List tickets')."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Fallback response is degraded\", function () { pm.expect(pm.response.json().degraded).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create ticket after recovery",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"route_id\": \"{{routeId}}\",\n  \"passenger_name\": \"Recovered User\",\n  \"travel_date\": \"{{travelDate}}\",\n  \"seats\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Run about 12 seconds after docker compose start route-service."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Not degraded again\", function () { pm.expect(pm.response.json().degraded).to.eql(false); });"
                ]
              }
            }
          ]
        }
      ],
      "description": "MANUAL: run these one by one, not with the Runner.\n\n1. Run folder 1 (Create route) so {{routeId}} is set.\n2. In a terminal: docker compose stop route-service\n3. Send 'Create ticket while route-service is down' three times: 503 'unreachable after 3 attempts'.\n4. Send it again straight away: 503 'circuit breaker open', returned instantly.\n5. Send 'Get ticket (fallback)': 200 with degraded=true.\n6. docker compose start route-service, wait ~12 seconds, send 'Create ticket after recovery': 201.\nWatch the retry, backoff and breaker lines with: docker compose logs -f ticket-service"
    }
  ]
