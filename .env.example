# Copy to .env (cp .env.example .env) and edit. All values are optional:
# the defaults in docker-compose.yml are used for anything left unset.

# Host port the gateway is published on
GATEWAY_PORT=8080
GATEWAY_TIMEOUT_MS=10000

# route-service database
ROUTE_DB_USER=route_user
ROUTE_DB_PASSWORD=route_pass
ROUTE_DB_NAME=route_db

# ticket-service database
TICKET_DB_USER=ticket_user
TICKET_DB_PASSWORD=ticket_pass
TICKET_DB_NAME=ticket_db

# Resilience: ticket-service -> route-service
ROUTE_TIMEOUT_MS=2000        # per-attempt timeout
ROUTE_MAX_ATTEMPTS=3         # total tries including the first
ROUTE_BACKOFF_MS=200         # first retry wait; doubles each retry
CB_FAILURE_THRESHOLD=3       # consecutive failed calls that open the breaker
CB_OPEN_SECONDS=10           # how long the breaker stays open before probing
